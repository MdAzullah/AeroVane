{
  "name": "aerovane",
  "version": "1.0.0",
  "description": "AeroVane — High-performance drone telemetry & flight log analysis suite",
  "author": "MD Azizullah <md.azizullah.engineer@gmail.com>",
  "license": "MIT",
  "scripts": {
    "dev": "npm --prefix apps/live-viewer run dev",
    "dev:live": "npm --prefix apps/live-viewer run dev",
    "dev:saved": "node scripts/serve-aerovane.mjs --directory apps/saved-log-viewer --port 8080 --open",
    "dev:bridge": "node scripts/mavlink-bridge.mjs 'fakesource://' wsserver://127.0.0.1:9988",
    "bridge": "node scripts/mavlink-bridge.mjs",
    "build:saved-ai": "npm --prefix apps/live-viewer exec -- esbuild apps/saved-log-viewer/ai-entry.ts --bundle --format=iife --platform=browser --target=es2020 --outfile=apps/saved-log-viewer/ai-analysis.js",
    "build:saved-map": "npm --prefix apps/live-viewer exec -- esbuild apps/saved-log-viewer/map-entry.ts --bundle --format=iife --platform=browser --target=es2020 --outfile=apps/saved-log-viewer/map-runtime.js",
    "build": "npm run build:saved-ai && npm run build:saved-map && npm --prefix apps/live-viewer run build && node scripts/build-dist.mjs",
    "start": "node scripts/serve-aerovane.mjs --open",
    "serve": "node scripts/serve-aerovane.mjs",
    "install:local": "bash scripts/install-local-service.sh",
    "test:saved": "node --test apps/saved-log-viewer/tests/*.test.mjs",
    "test": "npm run test:saved && npm --prefix apps/live-viewer test",
    "typecheck": "npm --prefix apps/live-viewer run typecheck",
    "verify": "npm run build:saved-ai && npm run build:saved-map && npm run test:saved && npm --prefix apps/live-viewer run verify"
  },
  "devDependencies": {
    "maplibre-gl": "^5.24.0",
    "pmtiles": "^4.5.0"
  }
}
